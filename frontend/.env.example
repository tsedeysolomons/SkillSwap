# Where the SkillSwap backend is reachable from the app.
#
# Defaults (used when this is unset):
#   Android emulator -> http://10.0.2.2:5000   (localhost is the emulator itself)
#   iOS simulator    -> http://localhost:5000
#   Web              -> http://localhost:5000
#
# On a PHYSICAL device you must set this to your machine's LAN IP, e.g.:
# EXPO_PUBLIC_SKILLSWAP_API_URL=http://192.168.1.20:5000
#
# Copy this file to `.env` and edit. Only EXPO_PUBLIC_* vars reach the app bundle.
EXPO_PUBLIC_SKILLSWAP_API_URL=http://localhost:5000
